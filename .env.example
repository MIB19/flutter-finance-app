# ── keuangan-app config ──
# Copy this file to .env (which is gitignored) and fill in the values.

# Base URL of the backend API.
# Android emulator reaches your host machine via 10.0.2.2 (not localhost).
# Real device on same Wi-Fi: use your PC's LAN IP, e.g. http://192.168.1.10:4000
API_BASE_URL=http://10.0.2.2:4000

# Supabase → Project Settings → API → "Project URL".
SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase → Project Settings → API → "Project API keys" → "anon public" key.
# This key is meant for client apps (protected by RLS/backend), safe to ship.
SUPABASE_ANON_KEY=<anon-public-key>

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs →
# the *Web application* client ID (used as serverClientId for Google Sign-In).
# This is the SAME Web client ID you paste into Supabase's Google auth provider.
GOOGLE_WEB_CLIENT_ID=<web-client-id>.apps.googleusercontent.com
